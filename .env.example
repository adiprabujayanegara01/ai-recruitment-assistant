# Salin menjadi .env lalu ISI semua nilai. Jangan commit file .env.
ENVIRONMENT=development
POSTGRES_PASSWORD=ganti-ini

# Keamanan: buat dengan  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-dengan-string-acak-panjang
JWT_SECRET=ganti-dengan-string-acak-lain
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-password-admin-minimal-12-karakter
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Embedding: auto | sentence-transformers | hashing
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# LLM: none (rule-based, offline) | anthropic | openai_compatible
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=
OUTPUT_LANGUAGE=id

# Upload & retensi
MAX_UPLOAD_MB=5
RETENTION_DAYS=180
